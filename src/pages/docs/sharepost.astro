---
import Code from "../../components/Code.astro";
import ShareButtons from "@plugdash/sharepost/ShareButtons.astro";
import InstallCommand from "../../components/InstallCommand.astro";
import PluginReference from "../../components/PluginReference.astro";
import { DEMO_URL, loadDemoEntry } from "../../data/demo-entry";
import { pluginDocToc } from "../../data/doc-toc";
import { getPlugin } from "../../data/plugins";
import Doc from "../../layouts/Doc.astro";

const plugin = getPlugin("sharepost")!;
const demo = await loadDemoEntry();
const tocEntries = pluginDocToc.filter((e) => e.id !== "register");
---

<Doc
  tocEntries={tocEntries}
  currentSlug="sharepost"
  title="sharepost"
  section="@plugdash/sharepost"
  description="Social share buttons with no JavaScript libraries."
>
  <h2 id="what-it-does">What it does</h2>
  <p>
    Builds share links for X, LinkedIn, Bluesky, WhatsApp and email when
    the page renders, from the page URL and the post title. Nothing is
    stored, no third-party JavaScript loads, nothing tracks the reader.
    Ships <code>ShareButtons.astro</code> with four variants.
  </p>

  <h2 id="install">Install</h2>
  <InstallCommand command={plugin.installCommand} />
  <p>
    There is nothing to register. Set <code>site</code> in
    <code>astro.config.mjs</code> so the links point at your public URL
    and not at the request host:
  </p>
  <Code language="js" filename="astro.config.mjs" code={`export default defineConfig({
  site: "https://example.com",
  // ...
})`} />

  <h2 id="add-the-component">Add the component</h2>
  <Code language="astro" code={`---
import ShareButtons from "@plugdash/sharepost/ShareButtons.astro"
---
<ShareButtons post={post} via="yourhandle" />`} />
  <p>
    <code>via</code> is your X handle without the @. It is added to the X
    link only. Pass <code>url</code> to share a different address than the
    current page.
  </p>

  <h2 id="live-demo">Live demo</h2>
  {demo ? (
    <>
      <p>Links for a real post on this site:</p>
      <div class="demo-inline">
        <ShareButtons post={demo} url={DEMO_URL} via="abhinavs" />
      </div>
    </>
  ) : (
    <p>The demo post is not published yet.</p>
  )}

  <PluginReference plugin={plugin} />

  <h2 id="for-agents">For agents</h2>
  <p>
    After installing @plugdash/sharepost, set <code>site</code> in
    <code>astro.config.mjs</code>, import <code>ShareButtons.astro</code>
    in the post layout and render
    <code>&lt;ShareButtons post=&#123;post&#125; /&gt;</code>. Do not
    register a plugin. Open a published post and check that the X link
    contains the encoded post URL. If the links point at localhost or a
    preview host, <code>site</code> is missing. Data stored: none.
  </p>
</Doc>
