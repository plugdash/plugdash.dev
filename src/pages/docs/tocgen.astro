---
import Code from "../../components/Code.astro";
import TableOfContents from "@plugdash/tocgen/TableOfContents.astro";
import InstallCommand from "../../components/InstallCommand.astro";
import PluginReference from "../../components/PluginReference.astro";
import { loadDemoEntry } from "../../data/demo-entry";
import { pluginDocToc } from "../../data/doc-toc";
import { getPlugin } from "../../data/plugins";
import Doc from "../../layouts/Doc.astro";

const plugin = getPlugin("tocgen")!;
const demo = await loadDemoEntry();
const tocEntries = pluginDocToc.filter((e) => e.id !== "register");
---

<Doc
  tocEntries={tocEntries}
  currentSlug="tocgen"
  title="tocgen"
  section="@plugdash/tocgen"
  description="Nested table of contents from Portable Text headings."
>
  <h2 id="what-it-does">What it does</h2>
  <p>
    Reads the h2, h3 and h4 blocks in your Portable Text body when the
    page renders and builds a nested table of contents. Posts with fewer
    than <code>minHeadings</code> headings (default 3) get nothing.
    Nothing is stored. Ships <code>TableOfContents.astro</code>, with a
    sticky option, and <code>HeadingAnchors.astro</code>, which gives each
    rendered heading the id the TOC links to.
  </p>

  <h2 id="install">Install</h2>
  <InstallCommand command={plugin.installCommand} />
  <p>
    There is nothing to register. tocgen has no hooks, so you do not add
    it to <code>astro.config.mjs</code>.
  </p>

  <h2 id="add-the-component">Add the components</h2>
  <Code language="astro" code={`---
import TableOfContents from "@plugdash/tocgen/TableOfContents.astro"
import HeadingAnchors from "@plugdash/tocgen/HeadingAnchors.astro"
---
<TableOfContents post={post} sticky />
<article>
  <PortableText value={post.data.content} />
</article>
<HeadingAnchors selector="article" />`} />
  <p>
    <code>HeadingAnchors</code> sets ids on the headings inside the
    element that <code>selector</code> matches. Without it, the TOC links
    have nothing to jump to unless your theme already adds matching ids.
  </p>

  <h2 id="live-demo">Live demo</h2>
  {demo ? (
    <>
      <p>Built from the headings of a real post on this site:</p>
      <div class="demo-inline">
        <TableOfContents post={demo} />
      </div>
    </>
  ) : (
    <p>The demo post is not published yet.</p>
  )}

  <PluginReference plugin={plugin} />

  <h2 id="for-agents">For agents</h2>
  <p>
    After installing @plugdash/tocgen, add
    <code>&lt;TableOfContents post=&#123;post&#125; /&gt;</code> to the
    post layout and <code>&lt;HeadingAnchors selector="article" /&gt;</code>
    after the element that holds the body. Do not register a plugin.
    Open a post with three or more headings and check that every TOC
    link jumps to its heading. If no TOC renders, the post has too few
    headings or the body field is not found: pass <code>field</code>.
    Data stored: none.
  </p>
</Doc>
