const plugin = getPlugin("fromsubstack")!;

const tocEntries = [
  { id: "what-it-does", text: "What it does", level: 2 as const, children: [] },
  { id: "install", text: "Install", level: 2 as const, children: [] },
  { id: "get-an-api-token", text: "Get an API token", level: 2 as const, children: [] },
  { id: "export", text: "Export from Substack", level: 2 as const, children: [] },
  { id: "run-the-import", text: "Run the import", level: 2 as const, children: [] },
  { id: "how-it-works", text: "How it works", level: 2 as const, children: [] },
  { id: "known-limitations", text: "Known limitations", level: 2 as const, children: [] },
  { id: "props", text: "Options", level: 2 as const, children: [] },
