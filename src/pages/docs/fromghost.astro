  { id: "install", text: "Install", level: 2 as const, children: [] },
  { id: "get-an-api-token", text: "Get an API token", level: 2 as const, children: [] },
  { id: "export", text: "Export from Ghost", level: 2 as const, children: [] },
  { id: "run-the-import", text: "Run the import", level: 2 as const, children: [] },
