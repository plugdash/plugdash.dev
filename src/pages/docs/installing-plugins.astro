---
import Code from "../../components/Code.astro";
import InstallCommand from "../../components/InstallCommand.astro";
import Doc from "../../layouts/Doc.astro";

const tocEntries = [
  { id: "two-kinds", text: "Two kinds of plugin", level: 2 as const, children: [] },
  { id: "the-code-path", text: "The code path", level: 2 as const, children: [
    { id: "step-1-npm-install", text: "Step 1: npm install", level: 3 as const, children: [] },
    { id: "step-2-register", text: "Step 2: register in astro.config.mjs", level: 3 as const, children: [] },
    { id: "step-3-restart", text: "Step 3: restart the dev server", level: 3 as const, children: [] },
  ]},
  { id: "admin-settings", text: "Admin settings", level: 2 as const, children: [] },
  { id: "add-the-component", text: "Add the component to your theme", level: 2 as const, children: [] },
  { id: "remove-a-plugin", text: "Remove a plugin", level: 2 as const, children: [] },
  { id: "troubleshooting", text: "Troubleshooting", level: 2 as const, children: [] },
