---
import Code from "../../components/Code.astro";
import EngagementBar from "@plugdash/engage/EngagementBar.astro";
import InstallCommand from "../../components/InstallCommand.astro";
import PluginReference from "../../components/PluginReference.astro";
import { DEMO_URL, loadDemoEntry } from "../../data/demo-entry";
import { pluginDocToc } from "../../data/doc-toc";
import { getPlugin } from "../../data/plugins";
import Doc from "../../layouts/Doc.astro";

const plugin = getPlugin("engage")!;
const demo = await loadDemoEntry();
---

<Doc
  tocEntries={pluginDocToc}
  currentSlug="engage"
  title="engage"
  section="@plugdash/engage"
  description="Heart, share and copy link in one component."
>
  <h2 id="what-it-does">What it does</h2>
  <p>
    Puts <code>HeartButton</code> (heartpost), <code>ShareButtons</code>
    (sharepost) and <code>CopyLink</code> (shortlink) in one row as
    <code>EngagementBar.astro</code>, with the same variant, size and theme
    on all three. engage has no plugin logic of its own and is not
    registered.
  </p>

  <h2 id="install">Install</h2>
  <InstallCommand command={plugin.installCommand} />

  <h2 id="register">Register</h2>
  <p>
    Register heartpost and shortlink. sharepost renders at page time and
    needs no registration. Do not register anything from
    <code>@plugdash/engage</code>.
  </p>
  <Code language="js" filename="astro.config.mjs" code={`import { defineConfig } from "astro/config"
import emdash from "emdash/astro"
import { heartpostPlugin } from "@plugdash/heartpost"
import { shortlinkPlugin } from "@plugdash/shortlink"

export default defineConfig({
  site: "https://example.com",
  integrations: [
    emdash({
      plugins: [
        heartpostPlugin({ collections: ["posts"] }),
        shortlinkPlugin(),
      ],
    }),
  ],
})`} />

  <h2 id="add-the-component">Add the component</h2>
  <Code language="astro" code={`---
import EngagementBar from "@plugdash/engage/EngagementBar.astro"
---
<EngagementBar post={post} via="yourhandle" />`} />

  <h2 id="live-demo">Live demo</h2>
  {demo ? (
    <div class="demo-inline">
      <EngagementBar post={demo} url={DEMO_URL} via="abhinavs" attribution />
    </div>
  ) : (
    <p>The demo post is not published yet.</p>
  )}

  <PluginReference plugin={plugin} />

  <h2 id="for-agents">For agents</h2>
  <p>
    After installing @plugdash/engage with heartpost, sharepost and
    shortlink, register <code>heartpostPlugin()</code> and
    <code>shortlinkPlugin()</code> only, import
    <code>EngagementBar.astro</code> in the post layout and render
    <code>&lt;EngagementBar post=&#123;post&#125; /&gt;</code>. Check a
    published post: the heart count loads on scroll, the share links carry
    the post URL, and the copied short link redirects. If the heart shows
    no count, heartpost is not registered or the post's collection is not
    in its <code>collections</code>. Data stored: none of its own.
  </p>
</Doc>
