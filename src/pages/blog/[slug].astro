---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import HeadingAnchors from "@plugdash/tocgen/HeadingAnchors.astro";
import Post from "../../layouts/Post.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

// The entry goes to the layout and the plugin components as-is. Reading time,
// TOC and share links are worked out by the components from the real body.
const { entry: post } = await getEmDashEntry("blog", slug);
if (!post) return Astro.redirect("/404");
---

<Post post={post}>
  <PortableText value={post.data.content} />
  <HeadingAnchors selector=".post-content" />
</Post>
