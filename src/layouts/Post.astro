---
import EngagementBar from "@plugdash/engage/EngagementBar.astro";
import ReadingTime from "@plugdash/readtime/ReadingTime.astro";
import TableOfContents from "@plugdash/tocgen/TableOfContents.astro";
import { getSeoMeta } from "emdash";
import type { Blog } from "../../emdash-env";
import Base from "./Base.astro";

interface Props {
  // The entry from getEmDashEntry("blog", slug), passed through unchanged
  post: { id: string; data: Blog };
}

const { post } = Astro.props;
const { title, publishedAt } = post.data;
// SEO panel values win; socialcard writes its card to seo.image on publish
const seo = getSeoMeta(post, {
  siteUrl: Astro.site?.origin ?? Astro.url.origin,
  defaultDescription: post.data.description,
});
const dateLabel = publishedAt
  ? publishedAt.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
  : null;
---

<Base title={seo.ogTitle} description={seo.description ?? undefined} ogImage={seo.ogImage ?? undefined}>
  <article class="post">
    <div class="post-layout container">
      <aside class="post-toc">
        <TableOfContents post={post} sticky />
      </aside>

      <div class="post-body">
        <header class="post-header">
          <h1>{title}</h1>
          <div class="post-meta">
            <ReadingTime post={post} variant="inline" />
            {dateLabel && <span class="post-date">{dateLabel}</span>}
          </div>
        </header>

        <div class="post-content">
          <slot />
        </div>

        <footer class="post-footer">
          <EngagementBar
            post={post}
            via="abhinavs"
            platforms={["twitter", "linkedin", "whatsapp", "bluesky", "email"]}
            attribution
          />
        </footer>
      </div>
    </div>
  </article>
</Base>

<style>
  .post {
    padding: 3rem 0 4rem;
  }
  .post-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .post-layout {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .post-toc {
    display: none;
  }
  @media (min-width: 1024px) {
    .post-toc {
      display: block;
    }
  }
  .post-body {
    max-width: 68ch;
  }
  .post-header {
    margin-bottom: 2rem;
  }
  .post-header h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .post-date::before {
    content: "- ";
  }
  .post-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .post-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .post-content :global(p) {
    margin-block: 1rem;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-block: 1rem;
    padding-left: 1.5rem;
  }
  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
