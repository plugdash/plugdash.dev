---
import ShareButtons from "@plugdash/sharepost/ShareButtons.astro";
import { resolveDocs } from "../lib/content";
import Base from "./Base.astro";

interface TocEntry {
  id: string;
  text: string;
  level?: 2 | 3 | 4;
  children?: TocEntry[];
}

interface Props {
  title: string;
  description?: string;
  section?: string;
  currentSlug: string;
  tocEntries: TocEntry[];
}

// Docs pages are Astro pages, not EmDash posts, so there is no body for
// readtime or tocgen to read and no entry id for heartpost or shortlink.
// The share buttons share this page's real URL; the "On this page" list is
// the page's own headings. The live plugin demos run on a real post (see
// src/data/demo-entry.ts).
const { title, description, section, currentSlug, tocEntries } = Astro.props;
const docs = await resolveDocs();
const grouped = {
  "on-ramp": docs.filter((d) => d.section === "on-ramp"),
  plugins: docs.filter((d) => d.section === "plugins"),
};
---

<Base title={title} description={description}>
  <article class="doc">
    <div class="doc-layout container">
      <nav class="doc-nav" aria-label="Docs">
        <div class="doc-nav-group">
          <div class="doc-nav-label">On-ramp</div>
          <ul>
            {grouped["on-ramp"].map((d) => (
              <li>
                <a href={d.href} aria-current={d.slug === currentSlug ? "page" : undefined}>
                  {d.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="doc-nav-group">
          <div class="doc-nav-label">Plugins</div>
          <ul>
            {grouped.plugins.map((d) => (
              <li>
                <a href={d.href} aria-current={d.slug === currentSlug ? "page" : undefined}>
                  {d.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </nav>

      <div class="doc-body">
        <header class="doc-header">
          {section && <div class="eyebrow">{section}</div>}
          <h1>{title}</h1>
          <div class="doc-meta">
            <ShareButtons title={`${title} - PlugDash docs`} via="abhinavs" variant="circle" size="sm" />
          </div>
        </header>
        <div class="doc-content">
          <slot />
        </div>
        <footer class="doc-footer">
          <a href="https://plugdash.dev" class="doc-attribution" rel="noopener">
            built with plugdash.dev
          </a>
        </footer>
      </div>

      <aside class="doc-toc">
        {tocEntries.length > 0 && (
          <nav class="toc-list" aria-label="On this page">
            <div class="doc-nav-label">On this page</div>
            <ul>
              {tocEntries.map((e) => (
                <li><a href={`#${e.id}`}>{e.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </aside>
    </div>
  </article>
</Base>

<style>
  .doc {
    padding: 2rem 0 4rem;
  }
  .doc-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .doc-layout {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
      gap: 2.5rem;
    }
  }

  .doc-nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .doc-nav {
      display: block;
      position: sticky;
      top: 1rem;
      align-self: start;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
  .doc-nav-group {
    margin-bottom: 1.25rem;
  }
  .doc-nav-label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .doc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .doc-nav li {
    margin: 0;
  }
  .doc-nav a {
    display: block;
    padding: 0.3rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .doc-nav a:hover {
    color: var(--text);
  }
  .doc-nav a[aria-current="page"] {
    color: var(--accent);
  }

  .doc-toc {
    display: none;
  }
  @media (min-width: 1024px) {
    .doc-toc {
      display: block;
    }
  }

  @media (min-width: 1024px) {
    .toc-list {
      position: sticky;
      top: 1rem;
    }
  }
  .toc-list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-list a {
    display: block;
    padding: 0.25rem 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .toc-list a:hover {
    color: var(--text);
  }

  .doc-body {
    max-width: 68ch;
    min-width: 0;
  }
  .doc-header {
    margin-bottom: 2rem;
  }
  .doc-header .eyebrow {
    margin-bottom: 0.5rem;
  }
  .doc-header h1 {
    font-size: 2rem;
  }
  .doc-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .doc-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .doc-attribution {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .doc-attribution:hover {
    color: var(--text);
  }
  .doc-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .doc-content :global(h3) {
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }
  .doc-content :global(p) {
    margin-block: 1rem;
  }
  .doc-content :global(ul),
  .doc-content :global(ol) {
    margin-block: 1rem;
    padding-left: 1.5rem;
  }
  .doc-content :global(pre:not(.shiki)) {
    margin-block: 1rem;
  }
  .doc-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-block: 1rem;
  }
  .doc-content :global(th),
  .doc-content :global(td) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .doc-content :global(th) {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .doc-content :global(.demo-inline) {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    margin-block: 1rem;
  }
</style>
